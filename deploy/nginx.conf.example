# Sustituir DOMINIO_REAL y las rutas del certificado antes de instalar.
# La app debe estar ligada únicamente a 127.0.0.1:8000.
server {
    listen 80;
    server_name DOMINIO_REAL;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name DOMINIO_REAL;
    ssl_certificate /etc/letsencrypt/live/DOMINIO_REAL/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMINIO_REAL/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 3m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
